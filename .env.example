# AutoChecker Environment Configuration Example
# Copy this file to .env and configure real secrets.

# ==============================================================================
# Authentication & JWT Secrets (SEC-01, SEC-02)
# ==============================================================================
AUTH_USERNAME=admin@rait.ac.in
# Use: python scripts/make_password_hash.py to generate your bcrypt password hash
AUTH_PASSWORD_HASH=$2b$12$PLACEHOLDER_BCRYPT_HASH_GOES_HERE
# Must be at least 32 characters long
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key!
JWT_EXPIRE_MINUTES=60

# ==============================================================================
# Server & CORS
# ==============================================================================
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ==============================================================================
# Google Cloud Vision Credentials
# ==============================================================================
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
